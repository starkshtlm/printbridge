# printbridge — settings only. State (keys, job log, spool) lives in ./data, never here.
# Copy to .env, edit, then `docker compose up -d`. `printbridge init` can write this file for you.
# .env is gitignored and should be mode 0600 — `printbridge doctor` complains if it is not.

# ===== REQUIRED (the init wizard fills these) =====
# One entry per printer: name=uri[;driver=<ppd-or-model>]  — comma separated, first one is default.
#   home=ipp://192.168.1.50/ipp/print                     driverless (IPP Everywhere / AirPrint)
#   office=ipp://192.168.1.60/ipp/print                   a second printer
#   old=socket://192.168.1.70:9100;driver=gutenprint.5.3://brother-hl-2170w/expert
#   usb=ipp://100.101.102.103:631/printers/usb            a queue shared by CUPS on the home node
#   home=cups-pdf:/                                       MOCK: PDFs land in ./data/mock-out
PRINTERS=home=ipp://192.168.1.50/ipp/print
PRINTER_URI=                                      # legacy single-printer form, still accepted
PRINTER_NAME=home                                 # …with this queue name
PUBLIC_URL=https://print.example.com              # the address assistants connect to
EXPOSE=caddy-host                                 # caddy-host | caddy | funnel | cloudflared | none
                                                  # caddy-host = a proxy already owns 80/443 on this host;
                                                  # printbridge only ships deploy/caddy/printbridge.caddy

# ===== Defaults (rarely changed) =====
DEFAULT_PAPER=A4                                  # A4 | Letter
DEFAULT_DUPLEX=true
DEFAULT_COLOR=false
BIND=127.0.0.1:8000                               # always loopback — the proxy is the only public face
ADMIN_BIND=127.0.0.1:8001                         # /status, /metrics — loopback or tailnet IP, never public
CUPS_SERVER=cups:631                              # host:port of the CUPS server (compose service name)
AUTH_MODE=keys                                    # keys | none (none only with EXPOSE=none) | github/google (v1.1)
KEY_GRACE_MINUTES=60                              # an old key stays valid this long after `keys rotate`
CONFIRM_ABOVE_PAGES=10                            # above this, the assistant must pass confirmed=true
MAX_PAGES=100                                     # hard ceiling; a per-key --max-pages can only lower it
MAX_FETCH_MB=25                                   # print_url download limit
ALLOW_PRIVATE_URLS=false                          # true lets print_url reach LAN/tailnet/localhost
RATE_LIMIT_JOBS_PER_HOUR=30                       # per key; a per-key --rate can only lower it
KEEP_SPOOL_HOURS=0                                # 0 = delete the rendered file as soon as the job ends
JOB_LOG_RETENTION_DAYS=365                        # job metadata only — never content, never URLs
LOG_REQUEST_PATH=false                            # keep connector keys out of access logs
NOTIFY_WEBHOOK=                                   # Telegram bot URL or JSON webhook; empty = data/notify-outbox.jsonl
NOTIFY_EVENTS=printer_offline,unknown_origin,rate_limit,cert_expiring,probe_404
                                                  # add new_client for an informational message the first time
                                                  # a person uses a new assistant
AUTO_UPDATE=off                                   # off | weekly
LOCALE=sv_SE                                      # date format in the document header
TZ=Europe/Stockholm

# ===== v1.1 only (AUTH_MODE=github|google) — not used in v1.0 =====
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ALLOWED_USERS=
