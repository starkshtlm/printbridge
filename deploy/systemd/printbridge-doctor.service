[Unit]
Description=printbridge watchdog — doctor, alert on state change, weekly digest, retention
Documentation=https://github.com/starkshtlm/printbridge/blob/main/docs/operations.md
After=docker.service
Wants=network-online.target

[Service]
Type=oneshot

# Both lines must name the account that owns the checkout and may talk to Docker.
# Without User=, a system unit runs as root and %h expands to /root — which is how the first
# version of this file failed with status 203/EXEC every fifteen minutes. deploy/systemd/README.md
# has a one-liner that fills both in for you.
User=__PRINTBRIDGE_USER__
WorkingDirectory=__PRINTBRIDGE_DIR__
Environment=PRINTBRIDGE_DIR=__PRINTBRIDGE_DIR__
ExecStart=__PRINTBRIDGE_DIR__/deploy/systemd/printbridge-watchdog.sh

Nice=10
TimeoutStartSec=180
