# mail2print — optional e-mail lane. Copy to /etc/mail2print.env, chmod 600, root-owned.
M2P_IMAP_HOST=imap.gmail.com
M2P_IMAP_PORT=993
M2P_USER=print@example.com            # a dedicated mailbox, never a personal one
M2P_PASS=                             # an app password, not your account password
M2P_TOKEN=                            # a secret word that must appear in the subject — a password
M2P_ALLOWED=you@example.com,partner@example.com   # comma separated; forgeable, so the token matters
M2P_PRINTER=home                      # the CUPS queue name
CUPS_SERVER=127.0.0.1:631             # where CUPS is; for printbridge's compose stack: cups:631
M2P_SPOOL=/var/spool/mail2print
M2P_POLL_SECONDS=60
M2P_MAX_MB=25
