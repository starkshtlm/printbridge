[Unit]
Description=mail2print — print PDF attachments sent to a dedicated mailbox
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/mail2print.env
ExecStart=/usr/bin/python3 /opt/mail2print/mail2print.py
Restart=always
RestartSec=30
DynamicUser=yes
StateDirectory=mail2print
RuntimeDirectory=mail2print
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
